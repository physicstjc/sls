rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /delight_scores/{scoreId} {
      allow read: if true;

      allow create: if
        request.resource.data.keys().hasOnly([
          'id',
          'name',
          'score',
          'team',
          'mode',
          'opponent',
          'isComputer',
          'playedAt',
          'createdAt'
        ]) &&
        request.resource.data.id == scoreId &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 1 &&
        request.resource.data.name.size() <= 24 &&
        request.resource.data.score is number &&
        request.resource.data.score >= 0 &&
        request.resource.data.score <= 1000 &&
        request.resource.data.team in ['red', 'blue'] &&
        request.resource.data.mode in ['solo', 'two-player'] &&
        request.resource.data.opponent is string &&
        request.resource.data.opponent.size() >= 1 &&
        request.resource.data.opponent.size() <= 24 &&
        request.resource.data.isComputer is bool &&
        request.resource.data.playedAt is string &&
        request.resource.data.playedAt.size() >= 20 &&
        request.resource.data.playedAt.size() <= 30 &&
        request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }
  }
}
